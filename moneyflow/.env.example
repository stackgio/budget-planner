# SQLite for local development. For PostgreSQL see README ("PostgreSQL migration").
DATABASE_URL="file:./dev.db"

# Optional locally, REQUIRED before exposing MoneyFlow beyond localhost.
# When set, every page requires this passcode and a signed session cookie.
# MONEYFLOW_PASSCODE="choose-a-long-random-passphrase"
# MONEYFLOW_SESSION_SECRET="64+ random characters, e.g. from: openssl rand -hex 32"
