# Local development only. Never commit a real .env.
DATABASE_URL="postgresql://levelup:levelup_local_dev@localhost:5432/levelup_dev"
# Origin the browser uses. Passkeys are bound to this host name (RP ID).
APP_ORIGIN="http://localhost:3100"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="LEVEL UP 2027"
# Required to create the first (and only) account through /setup. Generate: openssl rand -hex 24
SETUP_TOKEN=""

# Encrypts private notes (faith, relationship, reflections). 32 random bytes, base64: openssl rand -base64 32
# Keep a safe copy — without it, encrypted notes cannot be read.
DATA_ENCRYPTION_KEY=""
