{
  "name": "levelup-2027",
  "version": "0.1.0",
  "private": true,
  "description": "LEVEL UP 2027 — private personal Life Operating System",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "dotenv -e .env.test -- sh -c 'prisma migrate deploy && vitest run tests/integration'",
    "test:e2e": "dotenv -e .env.test -- sh -c 'prisma migrate deploy && playwright test --trace off'",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "owner:create": "tsx --conditions=react-server scripts/create-owner.ts",
    "key:check": "tsx --conditions=react-server scripts/key-check.ts",
    "key:drill": "./scripts/key-recovery-drill.sh",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "backup:create": "tsx --conditions=react-server scripts/backup.ts create",
    "backup:verify": "tsx --conditions=react-server scripts/backup.ts verify",
    "backup:restore-test": "tsx --conditions=react-server scripts/backup.ts restore-test",
    "backup:drill": "tsx --conditions=react-server scripts/backup-drill.ts",
    "splash:generate": "tsx scripts/generate-splash.ts",
    "perf:probe": "tsx --conditions=react-server scripts/perf-probe.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "aws4fetch": "1.0.20",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "^16.4.6",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "19.2",
    "@types/react-dom": "19.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^8.0.0",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
