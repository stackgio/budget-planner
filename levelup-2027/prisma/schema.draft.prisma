// LEVEL UP 2027 — DRAFT schema (Phase 0 design artifact).
// Not yet migrated. Phase 1 turns this into versioned `prisma migrate` migrations,
// plus raw-SQL migrations for partial unique indexes and CHECK constraints noted below.
//
// Conventions:
//   * Money is integer cents (Int).
//   * Date-only facts use @db.Date; instants use timestamptz.
//   * Every owned row carries ownerId; all queries are owner-scoped server-side.
//   * Financial rows are never hard-deleted: corrections are reversals + AuditLog.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String // argon2id
  createdAt    DateTime @default(now()) @db.Timestamptz
  settings     UserSettings?
  sessions     Session[]
  passkeys     Passkey[]
}

model Session {
  id         String   @id // random 256-bit token hash
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz
  expiresAt  DateTime @db.Timestamptz
  userAgent  String?

  @@index([userId])
}

model Passkey {
  id           String   @id // credential ID (base64url)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey    Bytes
  counter      Int
  transports   String[]
  label        String?
  createdAt    DateTime @default(now()) @db.Timestamptz
}

model UserSettings {
  userId              String  @id
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone            String  @default("America/New_York")
  wakeTime            String  @default("06:00")
  bedTime             String  @default("21:30")
  briefingTime        String  @default("06:00")
  checkInTime         String  @default("17:00")
  reflectionTime      String  @default("21:00")
  quietStart          String  @default("21:45")
  quietEnd            String  @default("05:45")
  lockScreenPrivacy   LockScreenPrivacy @default(GENERIC)
  aiConsent           Boolean @default(false)
}

enum LockScreenPrivacy {
  GENERIC   // "Your morning briefing is ready"
  SUMMARY   // non-financial details
  FULL      // includes amounts
}

// ───────────────────────── Calendar ─────────────────────────

enum EventCategory {
  DOC_SHIFT
  OVERTIME_SHIFT
  ACTIVATION
  APPOINTMENT
  WORKOUT
  STUDY
  GIG
  DATE_NIGHT
  CHURCH
  CONTENT
  FINANCIAL
  PERSONAL
  OTHER
}

model CalendarEvent {
  id          String        @id @default(cuid())
  ownerId     String
  title       String
  description String?
  category    EventCategory
  start       DateTime      @db.Timestamptz
  end         DateTime      @db.Timestamptz
  allDay      Boolean       @default(false)
  timezone    String        @default("America/New_York")
  rrule       String?       // RFC 5545, e.g. FREQ=WEEKLY;BYDAY=SA,SU,MO,TU,WE
  reminderMin Int[]         // minutes before
  sourceType  String?       // e.g. "OVERTIME_SHIFT", "MODE_SESSION", "TASK"
  sourceId    String?
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz
  exceptions  EventException[]

  @@unique([ownerId, sourceType, sourceId]) // generated events cannot duplicate
  @@index([ownerId, start])
}

model EventException {
  id            String        @id @default(cuid())
  eventId       String
  event         CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  originalStart DateTime      @db.Timestamptz
  cancelled     Boolean       @default(false)
  start         DateTime?     @db.Timestamptz
  end           DateTime?     @db.Timestamptz
  title         String?
  description   String?

  @@unique([eventId, originalStart])
}

// Paydays are NOT stored as CalendarEvents: the calendar renders Payday rows as
// virtual read-only events, so payroll can never be duplicated on the calendar.

// ───────────────────────── Work modes ─────────────────────────

enum WorkMode {
  NORMAL
  OVERTIME
  ACTIVATION
  RECOVERY
}

model ModeSession {
  id           String    @id @default(cuid())
  ownerId      String
  mode         WorkMode
  startedAt    DateTime  @db.Timestamptz
  estimatedEnd DateTime? @db.Timestamptz
  endedAt      DateTime? @db.Timestamptz
  notes        String?
  // SQL: partial unique index — at most one open session per owner
  //   CREATE UNIQUE INDEX one_open_mode ON "ModeSession"("ownerId") WHERE "endedAt" IS NULL;
  @@index([ownerId, startedAt])
}

// ───────────────────────── Tasks & habits ─────────────────────────

enum TaskStatus {
  OPEN
  DONE
  SKIPPED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String     @id @default(cuid())
  ownerId     String
  parentId    String?
  parent      Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]     @relation("Subtasks")
  title       String
  description String?
  category    String?
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?  @db.Date
  dueTime     String?    // "HH:mm" local
  rrule       String?
  reminderAt  DateTime?  @db.Timestamptz
  status      TaskStatus @default(OPEN)
  completedAt DateTime?  @db.Timestamptz
  isTopThree  Boolean    @default(false)
  createdAt   DateTime   @default(now()) @db.Timestamptz
  updatedAt   DateTime   @updatedAt @db.Timestamptz

  @@index([ownerId, dueDate, status])
}

model Habit {
  id        String         @id @default(cuid())
  ownerId   String
  name      String         // Prayer, Bible reading, Gym, Speaking, Studying, Reading, Content, Reflection
  targetPerWeek Int        @default(7)
  optional  Boolean        @default(true) // optional habits are suppressed in OT/Activation/Recovery
  archived  Boolean        @default(false)
  checkIns  HabitCheckIn[]
}

model HabitCheckIn {
  id      String   @id @default(cuid())
  habitId String
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  note    String?

  @@unique([habitId, date]) // only ever created by an explicit user tap
}

// ───────────────────────── Payroll ─────────────────────────

enum PayKind {
  REGULAR
  OVERTIME
}

model PaySchedule {
  id                     String   @id @default(cuid())
  ownerId                String
  kind                   PayKind
  anchorOfficialDate     DateTime @db.Date // REGULAR 2026-11-27, OVERTIME 2026-12-04
  intervalDays           Int      @default(14)
  earlyDepositOffsetDays Int      @default(0) // REGULAR -1 (Thu), OVERTIME 0 (Fri)
  effectiveFrom          DateTime @db.Date
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @db.Timestamptz
  paydays                Payday[]
}

enum PaydayStatus {
  EXPECTED
  RECEIVED  // only set when an IncomeDeposit is confirmed
  ZERO      // user confirmed $0 (e.g. no overtime worked)
  SKIPPED
}

model Payday {
  id                  String        @id @default(cuid())
  ownerId             String
  scheduleId          String
  schedule            PaySchedule   @relation(fields: [scheduleId], references: [id])
  kind                PayKind
  officialDate        DateTime      @db.Date
  expectedDepositDate DateTime      @db.Date  // estimate only
  manualDepositDate   DateTime?     @db.Date  // user correction / holiday exception
  holidayNote         String?
  status              PaydayStatus  @default(EXPECTED)
  deposit             IncomeDeposit?
  overtimeShifts      OvertimeShift[]

  @@unique([scheduleId, officialDate])
  @@index([ownerId, kind, officialDate])
}

enum IncomeKind {
  REGULAR
  OVERTIME
  GIG
  OTHER
}

// The ONLY record meaning "money actually arrived". Created solely by user confirmation.
model IncomeDeposit {
  id                String           @id @default(cuid())
  ownerId           String
  kind              IncomeKind
  paydayId          String?          @unique // one deposit per payday → no double counting
  payday            Payday?          @relation(fields: [paydayId], references: [id])
  netCents          Int              // SQL CHECK (netCents >= 0)
  actualDepositDate DateTime         @db.Date
  notes             String?
  overtimeHours     Decimal?         @db.Decimal(6, 2)
  idempotencyKey    String           @unique
  createdAt         DateTime         @default(now()) @db.Timestamptz
  voidedAt          DateTime?        @db.Timestamptz // corrections: void + re-enter, with AuditLog
  plans             AllocationPlan[]
}

model CompensationRule {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  hourlyCents    Int?     // null → "rate not set"; estimates hidden
  multiplierBp   Int      @default(15000) // basis points, 1.5x
  effectiveFrom  DateTime @db.Date
}

enum OvertimeStatus {
  WORKED
  SUBMITTED
  APPROVED
  EXPECTED
  RECEIVED
  DISPUTED
}

model OvertimeShift {
  id                 String         @id @default(cuid())
  ownerId            String
  date               DateTime       @db.Date
  start              DateTime       @db.Timestamptz
  end                DateTime       @db.Timestamptz
  breakMinutes       Int            @default(0)
  overtimeHours      Decimal        @db.Decimal(6, 2)
  rateRuleId         String?
  expectedGrossCents Int?           // ESTIMATE, never treated as income
  isActivation       Boolean        @default(false)
  paydayId           String?
  payday             Payday?        @relation(fields: [paydayId], references: [id])
  status             OvertimeStatus @default(WORKED)
  notes              String?
}

// ───────────────────────── Challenges ─────────────────────────

enum ChallengeKind {
  DEBT
  MOVING_OUT
  SCHD
}

enum SelectionRule {
  BIG_FIRST_RANDOM_TOP_N
  SEQUENTIAL
}

enum ChallengeStatus {
  SETUP_REQUIRED
  ACTIVE
  COMPLETE
}

model Challenge {
  id            String          @id @default(cuid())
  ownerId       String
  kind          ChallengeKind
  name          String
  selectionRule SelectionRule
  topN          Int             @default(10)
  targetCents   Int?            // DEBT: null until user enters balance
  status        ChallengeStatus
  tiles         ChallengeTile[]

  @@unique([ownerId, kind])
}

enum TileStatus {
  OPEN
  COMPLETED
}

enum Provenance {
  LIVE
  IMPORTED_VERIFIED
  IMPORTED_PROVISIONAL // e.g. SCHD days 1–37 until confirmed
}

model ChallengeTile {
  id          String          @id @default(cuid())
  challengeId String
  challenge   Challenge       @relation(fields: [challengeId], references: [id])
  number      Int
  amountCents Int
  status      TileStatus      @default(OPEN)
  provenance  Provenance      @default(LIVE)
  completedOn DateTime?       @db.Date
  lines       AllocationLine[]
  payments    Payment[]

  @@unique([challengeId, number])
}

// ───────────────────────── Allocations & ledger ─────────────────────────

enum PlanKind {
  OVERTIME_ROULETTE // may only draw on IncomeKind.OVERTIME
  EXTRA_PAYCHECK    // may only draw on IncomeKind.REGULAR
  MANUAL
}

enum PlanStatus {
  DRAFT
  APPROVED
  PARTIAL
  COMPLETED
  CANCELLED
}

model AllocationPlan {
  id          String           @id @default(cuid())
  ownerId     String
  kind        PlanKind
  depositId   String
  deposit     IncomeDeposit    @relation(fields: [depositId], references: [id])
  status      PlanStatus       @default(DRAFT)
  rngSeed     String?          // reproducible proposal
  version     Int              @default(1) // optimistic concurrency
  createdAt   DateTime         @default(now()) @db.Timestamptz
  approvedAt  DateTime?        @db.Timestamptz
  lines       AllocationLine[]
}

enum AllocationTarget {
  ROTH
  FUN
  DEBT_TILE
  MOVING_TILE
  SCHD_DAY
  EMERGENCY
  GOAL
  UNALLOCATED
}

enum LineStatus {
  PLANNED   // draft only — reserves nothing
  APPROVED  // earmarked — counts against the deposit
  CONFIRMED // real transfer confirmed
  CANCELLED
  REVERSED
}

model AllocationLine {
  id          String           @id @default(cuid())
  planId      String
  plan        AllocationPlan   @relation(fields: [planId], references: [id])
  target      AllocationTarget
  tileId      String?
  tile        ChallengeTile?   @relation(fields: [tileId], references: [id])
  goalId      String?
  amountCents Int              // SQL CHECK (amountCents > 0)
  status      LineStatus       @default(PLANNED)
  payments    Payment[]
  // SQL: CREATE UNIQUE INDEX one_live_line_per_tile ON "AllocationLine"("tileId")
  //        WHERE "tileId" IS NOT NULL AND status IN ('APPROVED','CONFIRMED');
}

enum PaymentKind {
  DEBT_PAYMENT
  SAVINGS_TRANSFER
  INVESTMENT_CONTRIBUTION
  ROTH_CONTRIBUTION
  FUN_SPEND
  OTHER
}

// A confirmed real-world movement of money. Can exist without a line
// (contributions made outside Roulette).
model Payment {
  id                String          @id @default(cuid())
  ownerId           String
  kind              PaymentKind
  lineId            String?
  line              AllocationLine? @relation(fields: [lineId], references: [id])
  tileId            String?
  tile              ChallengeTile?  @relation(fields: [tileId], references: [id])
  amountCents       Int
  paidOn            DateTime        @db.Date
  taxYear           Int?            // Roth contributions
  idempotencyKey    String          @unique
  reversesPaymentId String?         @unique
  reversedAt        DateTime?       @db.Timestamptz
  createdAt         DateTime        @default(now()) @db.Timestamptz
  // SQL: CREATE UNIQUE INDEX one_payment_per_tile ON "Payment"("tileId")
  //        WHERE "tileId" IS NOT NULL AND "reversedAt" IS NULL AND "reversesPaymentId" IS NULL;
}

model RothYear {
  id         String  @id @default(cuid())
  ownerId    String
  taxYear    Int
  limitCents Int?    // user-entered; never hardcoded
  eligible   Boolean?
  note       String?

  @@unique([ownerId, taxYear])
}

model RouletteSettings {
  id               String   @id @default(cuid())
  ownerId          String
  planKind         PlanKind
  rothReserveCents Int      // OT default 10000; EXTRA_PAYCHECK default 0
  funMinimumCents  Int      // OT default 5000
  leftoverToFun    Boolean  @default(true)
  goalOrder        String[] // e.g. ["DEBT","MOVING_OUT","SCHD"]
  rotationPointer  Int      @default(0)

  @@unique([ownerId, planKind])
}

model AuditLog {
  id        String   @id @default(cuid())
  ownerId   String
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  at        DateTime @default(now()) @db.Timestamptz

  @@index([ownerId, entity, entityId])
}

// ───────────────────────── Notifications ─────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  ownerId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  label     String?
  createdAt DateTime @default(now()) @db.Timestamptz
}

enum JobStatus {
  PENDING
  SENT
  SUPPRESSED
  SNOOZED
  DISMISSED
  FAILED
}

model NotificationJob {
  id        String    @id @default(cuid())
  ownerId   String
  dedupeKey String    @unique // e.g. "briefing:2027-04-02", "xpay-month:2027-04:T-30"
  category  String    // BRIEFING | CHECKIN | REFLECTION | DEADLINE | FINANCE
  optional  Boolean   @default(true)
  fireAt    DateTime  @db.Timestamptz
  title     String
  body      String    // already privacy-filtered
  url       String?
  status    JobStatus @default(PENDING)
  reason    String?   // e.g. "suppressed: ACTIVATION mode"
  sentAt    DateTime? @db.Timestamptz

  @@index([status, fireAt])
}

// ───────────────────────── Growth modules (Phase 5, abbreviated) ─────────────────────────

model JournalEntry {
  id         String   @id @default(cuid())
  ownerId    String
  type       String   // PRAYER | GRATITUDE | REFLECTION | RELATIONSHIP | SPEAKING | WEEKLY_REVIEW
  date       DateTime @db.Date
  bodyCipher Bytes    // AES-256-GCM, app-level
  createdAt  DateTime @default(now()) @db.Timestamptz
}

model GigSession {
  id               String   @id @default(cuid())
  ownerId          String
  app              String   // DOORDASH | VEHO | INSTACART | SHIPT
  date             DateTime @db.Date
  minutes          Int
  grossCents       Int      // excludes tips
  tipsCents        Int      @default(0)
  miles            Decimal  @db.Decimal(7, 1)
  fuelCents        Int?     // actual
  vehicleCostBp    Int?     // estimated cents/mile snapshot at entry time
  taxReserveBp     Int?
}

model Goal {
  id          String   @id @default(cuid())
  ownerId     String
  horizon     String   // ANNUAL | QUARTER | MONTH | WEEK
  area        String   // FINANCE | FITNESS | FAITH | RELATIONSHIP | EDUCATION | CAREER | COMMUNICATION | CONTENT
  title       String
  periodStart DateTime @db.Date
  challengeId String?  // progress READS confirmed payments; never duplicates them
  targetValue Decimal?
  status      String   @default("ACTIVE")
}
