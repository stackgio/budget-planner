// LEVEL UP 2027 — Phase 1 schema.
// Conventions: money = integer cents; hours = integer hundredths; date-only facts = @db.Date;
// instants = timestamptz. Every owned row carries ownerId and every query is owner-scoped.
// Partial unique indexes / CHECK constraints live in raw SQL inside the migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  displayName  String        @default("Gio")
  passwordHash String
  createdAt    DateTime      @default(now()) @db.Timestamptz
  settings     UserSettings?
  sessions     Session[]
  passkeys     Passkey[]
}

model Session {
  id        String   @id // SHA-256 hash of the cookie token (raw token never stored)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz
  expiresAt DateTime @db.Timestamptz
  userAgent String?
  method    String   @default("password") // password | passkey

  @@index([userId])
}

/// Public-key credential only. No biometric data ever reaches the server:
/// Face ID / Touch ID stays on the device and only unlocks the private key.
model Passkey {
  id         String    @id // credential ID, base64url
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey  Bytes
  counter    BigInt    @default(0)
  transports String[]
  deviceType String?
  backedUp   Boolean   @default(false)
  label      String
  createdAt  DateTime  @default(now()) @db.Timestamptz
  lastUsedAt DateTime? @db.Timestamptz
}

model AuthChallenge {
  id        String   @id // random id stored in a short-lived httpOnly cookie
  challenge String
  purpose   String // register | login
  userId    String?
  expiresAt DateTime @db.Timestamptz
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // "global" or client IP
  success   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([key, createdAt])
}

model UserSettings {
  userId         String @id
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone       String @default("America/New_York")
  wakeTime       String @default("06:00")
  bedTime        String @default("21:30")
  briefingTime   String @default("06:00")
  checkInTime    String @default("17:00")
  reflectionTime String @default("21:00")
}

// ───────────────────────── Calendar ─────────────────────────

enum EventCategory {
  DOC_SHIFT
  OVERTIME_SHIFT
  ACTIVATION
  APPOINTMENT
  WORKOUT
  STUDY
  GIG
  DATE_NIGHT
  CHURCH
  CONTENT
  FINANCIAL
  PERSONAL
  OTHER
}

model CalendarEvent {
  id                String           @id @default(cuid())
  ownerId           String
  title             String
  description       String?
  location          String?
  category          EventCategory
  startAt           DateTime         @db.Timestamptz // first occurrence start
  endAt             DateTime         @db.Timestamptz // first occurrence end
  allDay            Boolean          @default(false)
  timezone          String           @default("America/New_York")
  rrule             String? // RFC 5545 subset, e.g. FREQ=WEEKLY;BYDAY=SA,SU,MO,TU,WE
  reminderMin       Int?
  important         Boolean          @default(false) // never suggested for rescheduling
  optional          Boolean          @default(false) // may be suggested for postponing in OT/activation
  sourceType        String? // generated events: OVERTIME_SHIFT | MODE_SESSION | DOC_SCHEDULE | DATE_PLAN
  sourceId          String?
  createdAt         DateTime         @default(now()) @db.Timestamptz
  updatedAt         DateTime         @updatedAt @db.Timestamptz
  exceptions        EventException[]
  goal              Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  goalId            String?
  workoutTemplateId String? // fitness: which template this scheduled workout uses

  @@unique([ownerId, sourceType, sourceId])
  @@index([ownerId, startAt])
}

/// One changed or cancelled occurrence of a recurring event. The series is untouched.
model EventException {
  id            String        @id @default(cuid())
  eventId       String
  event         CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  originalStart DateTime      @db.Timestamptz
  cancelled     Boolean       @default(false)
  startAt       DateTime?     @db.Timestamptz
  endAt         DateTime?     @db.Timestamptz
  title         String?
  description   String?

  @@unique([eventId, originalStart])
}

// ───────────────────────── Work modes ─────────────────────────

enum WorkMode {
  NORMAL
  OVERTIME
  ACTIVATION
  RECOVERY
}

model ModeSession {
  id           String    @id @default(cuid())
  ownerId      String
  mode         WorkMode
  startedAt    DateTime  @db.Timestamptz
  estimatedEnd DateTime? @db.Timestamptz
  endedAt      DateTime? @db.Timestamptz
  notes        String?
  eventId      String? // calendar event created for an activation

  // SQL: one open session per owner (partial unique index in migration).
  @@index([ownerId, startedAt])
}

// ───────────────────────── Tasks & habits ─────────────────────────

enum TaskStatus {
  OPEN
  DONE
  SKIPPED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String     @id @default(cuid())
  ownerId     String
  parentId    String?
  parent      Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]     @relation("Subtasks")
  title       String
  description String?
  category    String?
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?  @db.Date
  dueTime     String? // "HH:mm" local
  rrule       String?
  reminderMin Int?
  optional    Boolean    @default(false)
  isTopThree  Boolean    @default(false)
  goalId      String?
  goal        Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  status      TaskStatus @default(OPEN)
  completedAt DateTime?  @db.Timestamptz
  createdAt   DateTime   @default(now()) @db.Timestamptz
  updatedAt   DateTime   @updatedAt @db.Timestamptz

  @@index([ownerId, status, dueDate])
}

model Habit {
  id            String         @id @default(cuid())
  ownerId       String
  name          String
  emoji         String?
  targetPerWeek Int            @default(7)
  optional      Boolean        @default(true)
  sortOrder     Int            @default(0)
  archived      Boolean        @default(false)
  checkIns      HabitCheckIn[]

  @@unique([ownerId, name])
}

/// Only ever created by an explicit tap. Never automatic.
model HabitCheckIn {
  id      String   @id @default(cuid())
  habitId String
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date

  @@unique([habitId, date])
}

// ───────────────────────── Payroll ─────────────────────────

enum PayKind {
  REGULAR
  OVERTIME
}

model PaySchedule {
  id                     String   @id @default(cuid())
  ownerId                String
  kind                   PayKind
  anchorOfficialDate     DateTime @db.Date
  anchorVerified         Boolean  @default(false)
  intervalDays           Int      @default(14)
  earlyDepositOffsetDays Int      @default(0)
  updatedAt              DateTime @updatedAt @db.Timestamptz

  @@unique([ownerId, kind])
}

enum PaydayStatus {
  EXPECTED
  RECEIVED // set only together with a confirmed IncomeDeposit
  ZERO // user confirmed nothing was paid (e.g. no overtime worked)
  SKIPPED
}

model Payday {
  id                  String          @id @default(cuid())
  ownerId             String
  kind                PayKind
  officialDate        DateTime        @db.Date
  expectedDepositDate DateTime        @db.Date // estimate only
  manualDepositDate   DateTime?       @db.Date // user override (e.g. holiday exception)
  holidayNote         String?
  status              PaydayStatus    @default(EXPECTED)
  note                String?
  createdAt           DateTime        @default(now()) @db.Timestamptz
  deposits            IncomeDeposit[] // at most one ACTIVE (non-voided) — partial unique index
  overtimeShifts      OvertimeShift[]

  @@unique([ownerId, kind, officialDate])
  @@index([ownerId, kind, officialDate])
}

enum IncomeKind {
  REGULAR
  OVERTIME
  GIG
  OTHER
}

/// The ONLY record meaning money actually arrived. Created solely by user confirmation.
/// Funding source for the ledger, Extra Paycheck Planner and Money Roulette.
/// Never deleted: a correction sets voidedAt (only allowed when nothing is committed against it).
model IncomeDeposit {
  id                String           @id @default(cuid())
  ownerId           String
  kind              IncomeKind
  paydayId          String?
  payday            Payday?          @relation(fields: [paydayId], references: [id])
  netCents          Int
  actualDepositDate DateTime         @db.Date
  notes             String?
  idempotencyKey    String?          @unique
  requestHash       String?
  voidedAt          DateTime?        @db.Timestamptz
  voidReason        String?
  createdAt         DateTime         @default(now()) @db.Timestamptz
  plans             AllocationPlan[]
  gigPayout         GigPayout?

  @@index([ownerId, kind])
  @@index([ownerId, actualDepositDate])
}

model PayRate {
  id                   String   @id @default(cuid())
  ownerId              String
  regularHourlyCents   Int // 2420 = $24.20
  overtimeMultiplierBp Int // 15000 = 1.5x
  provisional          Boolean  @default(true)
  effectiveFrom        DateTime @db.Date
  createdAt            DateTime @default(now()) @db.Timestamptz

  @@index([ownerId, effectiveFrom])
}

enum OvertimeStatus {
  WORKED
  SUBMITTED
  APPROVED
  EXPECTED
  RECEIVED
  DISPUTED
}

model OvertimeShift {
  id                  String         @id @default(cuid())
  ownerId             String
  date                DateTime       @db.Date
  startAt             DateTime       @db.Timestamptz
  endAt               DateTime       @db.Timestamptz
  breakMinutes        Int            @default(0)
  regularHoursX100    Int            @default(0) // extra hours paid at the regular rate
  overtimeHoursX100   Int            @default(0) // hours the user says qualify for the OT multiplier
  rateHourlyCents     Int // snapshot of the regular rate used for the estimate
  rateMultiplierBp    Int // snapshot of the multiplier used for the estimate
  estimatedGrossCents Int // ESTIMATE before taxes/deductions — never income
  isActivation        Boolean        @default(false)
  payrollPeriod       String?
  paydayId            String?
  payday              Payday?        @relation(fields: [paydayId], references: [id])
  status              OvertimeStatus @default(WORKED)
  notes               String?
  createdAt           DateTime       @default(now()) @db.Timestamptz

  @@index([ownerId, date])
}

// ───────────────────────── Challenge configuration (used by Phase 2) ─────────────────────────

enum ChallengeKind {
  DEBT
  MOVING_OUT
  SCHD
}

enum SelectionRule {
  BIG_FIRST_RANDOM_TOP_N
  SEQUENTIAL
}

enum ChallengeStatus {
  SETUP_REQUIRED
  ACTIVE
  COMPLETE
}

model Challenge {
  id             String          @id @default(cuid())
  ownerId        String
  kind           ChallengeKind
  name           String
  selectionRule  SelectionRule
  topN           Int             @default(10)
  targetCents    Int?
  nextNumber     Int? // SCHD: first day the roulette may pick (resume point)
  status         ChallengeStatus
  priorPaidCents Int? // DEBT: informational, paid before the challenge began
  setupNote      String?
  configuredAt   DateTime?       @db.Timestamptz
  tiles          ChallengeTile[]
  balances       DebtBalance[]

  @@unique([ownerId, kind])
}

enum TileStatus {
  OPEN
  PROVISIONAL // shown as previously done, NOT a verified financial record
  COMPLETED
}

model ChallengeTile {
  id          String           @id @default(cuid())
  challengeId String
  challenge   Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  number      Int
  amountCents Int
  status      TileStatus       @default(OPEN)
  lines       AllocationLine[]
  payments    Payment[]

  @@unique([challengeId, number])
}

/// Append-only debt balance snapshots. Corrections add a new row; history is never rewritten.
model DebtBalance {
  id           String    @id @default(cuid())
  challengeId  String
  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  balanceCents Int
  asOf         DateTime  @db.Date
  note         String?
  createdAt    DateTime  @default(now()) @db.Timestamptz
}

// ───────────────────────── Ledger & allocations (Phase 2) ─────────────────────────

enum PlanKind {
  OVERTIME_ROULETTE // may only be funded by an OVERTIME deposit
  EXTRA_PAYCHECK // may only be funded by a REGULAR deposit
}

enum PlanStatus {
  DRAFT // proposal only — reserves nothing
  APPROVED // lines reserved against the deposit
  COMPLETED // every line completed or cancelled, at least one completed
  CANCELLED
}

enum LineTarget {
  ROTH
  FUN
  EMERGENCY
  GOAL
  MOVING_TILE
  SCHD_DAY
  DEBT_TILE
}

enum LineStatus {
  PLANNED // in a draft
  RESERVED // approved, waiting for the real transfer
  COMPLETED // real transfer confirmed (paidCents may be less for non-tile lines)
  CANCELLED // released
}

model AllocationPlan {
  id            String           @id @default(cuid())
  ownerId       String
  kind          PlanKind
  depositId     String? // null only for a non-binding Extra Paycheck forecast draft
  deposit       IncomeDeposit?   @relation(fields: [depositId], references: [id], onDelete: Restrict)
  forecastMonth String? // YYYY-MM for extra-paycheck forecast drafts
  forecastCents Int?
  budgetCents   Int // what the user chose to make available (≤ deposit available)
  status        PlanStatus       @default(DRAFT)
  seed          String?
  params        Json? // last spin settings, so REROLL reuses them
  leftoverToFun Boolean          @default(false)
  notes         String?
  version       Int              @default(1)
  createdAt     DateTime         @default(now()) @db.Timestamptz
  updatedAt     DateTime         @updatedAt @db.Timestamptz
  approvedAt    DateTime?        @db.Timestamptz
  closedAt      DateTime?        @db.Timestamptz
  lines         AllocationLine[]

  @@index([ownerId, status])
}

model AllocationLine {
  id          String         @id @default(cuid())
  planId      String
  plan        AllocationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  target      LineTarget
  label       String?
  tileId      String?
  tile        ChallengeTile? @relation(fields: [tileId], references: [id], onDelete: Restrict)
  amountCents Int
  paidCents   Int?
  taxYear     Int? // required for ROTH lines (DB CHECK); intended contribution year
  status      LineStatus     @default(PLANNED)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now()) @db.Timestamptz
  settledAt   DateTime?      @db.Timestamptz
  payments    Payment[]

  @@index([planId])
}

enum PaymentKind {
  ROTH_CONTRIBUTION
  SAVINGS_TRANSFER
  INVESTMENT_CONTRIBUTION
  DEBT_PAYMENT
  FUN_MONEY
  EMERGENCY_SAVINGS
  GOAL_TRANSFER
}

enum PaymentSource {
  ROULETTE
  EXTRA_PAYCHECK
  MANUAL
  HISTORICAL_IMPORT
}

/// A confirmed real-world transfer the user made outside the app. LEVEL UP never moves money.
/// Corrections create a reversal row (negative amount) pointing at the original.
model Payment {
  id             String          @id @default(cuid())
  ownerId        String
  kind           PaymentKind
  source         PaymentSource
  lineId         String?
  line           AllocationLine? @relation(fields: [lineId], references: [id], onDelete: Restrict)
  tileId         String?
  tile           ChallengeTile?  @relation(fields: [tileId], references: [id], onDelete: Restrict)
  amountCents    Int
  paidOn         DateTime        @db.Date
  taxYear        Int?
  label          String?
  note           String?
  idempotencyKey String          @unique
  requestHash    String
  reversalOfId   String?         @unique
  reversalOf     Payment?        @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal       Payment?        @relation("Reversal")
  datePlan       DatePlan?
  reversedAt     DateTime?       @db.Timestamptz
  createdAt      DateTime        @default(now()) @db.Timestamptz

  @@index([ownerId, kind])
}

model RothYear {
  id         String  @id @default(cuid())
  ownerId    String
  taxYear    Int
  limitCents Int? // entered by the user — never a hardcoded IRS figure
  note       String?

  @@unique([ownerId, taxYear])
}

model RouletteSettings {
  id              String   @id @default(cuid())
  ownerId         String
  kind            PlanKind
  rothCents       Int
  funCents        Int
  leftoverToFun   Boolean
  topN            Int      @default(10)
  rotationPointer Int      @default(0)

  @@unique([ownerId, kind])
}

// ───────────────────────── Audit ─────────────────────────

model AuditLog {
  id       String   @id @default(cuid())
  ownerId  String
  entity   String
  entityId String
  action   String
  before   Json?
  after    Json?
  at       DateTime @default(now()) @db.Timestamptz

  @@index([ownerId, entity, entityId])
}

// ═════════════════════════ Phase 3 — Goals & Personal Growth ═════════════════════════
// Private free-text fields ending in "Cipher" are AES-256-GCM encrypted by the app before storage.

enum GoalCategory {
  FINANCE
  FITNESS
  FAITH
  RELATIONSHIP
  EDUCATION
  CAREER
  COMMUNICATION
  READING
  LEARNING
  DISCIPLINE
  TIME_MANAGEMENT
  PROJECT
  PERSONAL
}

enum GoalHorizon {
  YEAR
  QUARTER
  MONTH
  WEEK
}

enum GoalStatus {
  NOT_STARTED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/// Where a goal's progress comes from. Progress is never invented: it is read from records or manual entries.
enum ProgressSource {
  MANUAL
  MILESTONES
  TASKS
  HABIT
  CHALLENGE
  WORKOUTS
  ACTIVITY
}

model Goal {
  id           String          @id @default(cuid())
  ownerId      String
  title        String
  description  String?
  category     GoalCategory
  horizon      GoalHorizon
  priority     Priority        @default(MEDIUM)
  status       GoalStatus      @default(NOT_STARTED)
  startDate    DateTime        @db.Date
  targetDate   DateTime?       @db.Date
  unit         String?
  targetX100   Int? // measurable target × 100
  source       ProgressSource  @default(MANUAL)
  challengeId  String? // FINANCE: reads confirmed Phase 2 payments — never duplicates them
  habitId      String?
  activityKind String? // ACTIVITY source: ActivityKind to sum minutes of
  notesCipher  String?
  completedAt  DateTime?       @db.Timestamptz
  createdAt    DateTime        @default(now()) @db.Timestamptz
  updatedAt    DateTime        @updatedAt @db.Timestamptz
  milestones   GoalMilestone[]
  progress     GoalProgress[]
  tasks        Task[]
  events       CalendarEvent[]

  @@index([ownerId, status])
}

model GoalMilestone {
  id          String    @id @default(cuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime? @db.Date
  completedAt DateTime? @db.Timestamptz
  archivedAt  DateTime? @db.Timestamptz
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz
}

/// Manual progress updates — append-only history; the latest entry is the current value.
model GoalProgress {
  id             String   @id @default(cuid())
  goalId         String
  goal           Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  valueX100      Int
  recordedOn     DateTime @db.Date
  note           String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz
}

model GrowthSettings {
  ownerId          String @id
  workoutsPerWeek  Int    @default(3)
  weightUnit       String @default("lb")
  dateNightWeekday Int    @default(5) // 0=Sun … 5=Fri
  dateNightTime    String @default("18:30")
  faithDaysPerWeek Int    @default(5)
}

/// Reminder choices saved for Phase 4 notifications. Nothing is delivered yet.
model ReminderPreference {
  id      String  @id @default(cuid())
  ownerId String
  key     String
  time    String
  days    Int[]
  enabled Boolean @default(false)

  @@unique([ownerId, key])
}

// ───────────── Fitness ─────────────

model Exercise {
  id        String  @id @default(cuid())
  ownerId   String
  name      String
  category  String // UPPER | LOWER | CORE | FULL | CARDIO | MOBILITY
  equipment String // BODYWEIGHT | DUMBBELL | BAND | OTHER
  cues      String?
  archived  Boolean @default(false)

  @@unique([ownerId, name])
}

model WorkoutTemplate {
  id        String                @id @default(cuid())
  ownerId   String
  name      String
  notes     String?
  kind      String                @default("HOME") // HOME | GYM | RECOVERY
  archived  Boolean               @default(false)
  updatedAt DateTime              @default(now()) @updatedAt @db.Timestamptz
  items     WorkoutTemplateItem[]

  @@unique([ownerId, name])
}

model WorkoutTemplateItem {
  id         String          @id @default(cuid())
  templateId String
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId String
  sets       Int
  reps       String // e.g. "8–12" or "30 s"
  weightNote String? // e.g. "15 lb dumbbells" or "light band"
  restSec    Int?
  sortOrder  Int             @default(0)
}

enum WorkoutStatus {
  COMPLETED
  PARTIAL
}

/// A workout you say you did. Scheduling a workout never creates one of these.
model WorkoutLog {
  id             String        @id @default(cuid())
  ownerId        String
  date           DateTime      @db.Date
  templateId     String?
  title          String
  eventId        String? // the calendar occurrence it fulfils, if any
  originalStart  DateTime?     @db.Timestamptz
  durationMin    Int?
  effort         Int? // 1–10, optional
  status         WorkoutStatus @default(COMPLETED)
  notes          String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now()) @db.Timestamptz
  sets           WorkoutSet[]

  @@unique([ownerId, eventId, originalStart])
  @@index([ownerId, date])
}

model WorkoutSet {
  id          String     @id @default(cuid())
  logId       String
  log         WorkoutLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  exerciseId  String
  setNumber   Int
  reps        Int?
  weightX100  Int?
  durationSec Int?
}

model BodyMetric {
  id         String   @id @default(cuid())
  ownerId    String
  kind       String // WEIGHT | WAIST | CHEST | HIPS | ARMS | BODY_FAT
  valueX100  Int
  unit       String
  measuredOn DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([ownerId, kind, measuredOn])
}

// ───────────── Faith ─────────────

model FaithEntry {
  id             String   @id @default(cuid())
  ownerId        String
  kind           String // PRAYER | BIBLE_READING | REFLECTION | GRATITUDE
  date           DateTime @db.Date
  minutes        Int?
  passage        String?
  bodyCipher     String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([ownerId, date])
}

// ───────────── Relationship ─────────────

enum DateStatus {
  PLANNED
  COMPLETED
  POSTPONED
  CANCELLED
}

model DatePlan {
  id              String     @id @default(cuid())
  ownerId         String
  title           String
  date            DateTime   @db.Date
  startTime       String?
  endTime         String?
  eventId         String?
  status          DateStatus @default(PLANNED)
  budgetCents     Int?
  actualCostCents Int? // manual record — or link paymentId, never both (no double counting)
  paymentId       String?    @unique
  payment         Payment?   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  letter          String? // Alphabet Dating letter, if this date is for one
  notesCipher     String?
  completedAt     DateTime?  @db.Timestamptz
  createdAt       DateTime   @default(now()) @db.Timestamptz
  updatedAt       DateTime   @updatedAt @db.Timestamptz

  @@index([ownerId, date])
}

model DateIdea {
  id           String  @id @default(cuid())
  ownerId      String
  title        String
  category     String?
  estCostCents Int?
  letter       String?
  notes        String?
  archived     Boolean @default(false)
}

model ImportantDate {
  id      String  @id @default(cuid())
  ownerId String
  title   String
  kind    String // ANNIVERSARY | BIRTHDAY | OTHER
  month   Int
  day     Int
  year    Int?
  notes   String?
}

model RelationshipNote {
  id         String   @id @default(cuid())
  ownerId    String
  bodyCipher String
  createdAt  DateTime @default(now()) @db.Timestamptz
}

enum AlphabetStatus {
  OPEN
  PLANNED
  COMPLETED
  SKIPPED
}

/// One row per letter A–Z. A letter is completed only when its date is explicitly marked complete.
model AlphabetEntry {
  id             String         @id @default(cuid())
  ownerId        String
  letter         String
  activity       String?
  estBudgetCents Int?
  status         AlphabetStatus @default(OPEN)
  datePlanId     String?        @unique
  notes          String?
  completedAt    DateTime?      @db.Timestamptz
  updatedAt      DateTime       @updatedAt @db.Timestamptz

  @@unique([ownerId, letter])
}

// ───────────── Education & career ─────────────

model EduProgram {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  institution String
  credential  String?
  status      String   @default("RESEARCHING") // RESEARCHING | PLANNING | APPLYING | ADMITTED | ENROLLED | PAUSED | NOT_PURSUING
  notes       String?
  createdAt   DateTime @default(now()) @db.Timestamptz
}

model EduCourse {
  id         String    @id @default(cuid())
  ownerId    String
  programId  String?
  code       String?
  title      String
  credits    Int?
  term       String?
  status     String    @default("PLANNED") // PLANNED | REGISTERED | IN_PROGRESS | COMPLETED | DROPPED
  grade      String?
  notes      String?
  archivedAt DateTime? @db.Timestamptz
}

model TuitionItem {
  id          String    @id @default(cuid())
  ownerId     String
  term        String?
  label       String
  estCents    Int
  actualCents Int?
  notes       String?
  archivedAt  DateTime? @db.Timestamptz
}

model CareerProfile {
  ownerId  String    @id
  employer String
  title    String
  hireDate DateTime? @db.Date
  notes    String?
}

model CareerCredential {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  kind        String // TRAINING | CERTIFICATION
  status      String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED
  completedOn DateTime? @db.Date
  expiresOn   DateTime? @db.Date
  notes       String?
}

model JobOpportunity {
  id              String    @id @default(cuid())
  ownerId         String
  title           String
  agency          String
  level           String // PROMOTION | STATE | COUNTY | FEDERAL | OTHER
  location        String?
  payMinCents     Int? // entered by you from the posting — never invented
  payMaxCents     Int?
  payPeriod       String    @default("HOURLY") // HOURLY | ANNUAL
  deadline        DateTime? @db.Date
  status          String    @default("RESEARCHING") // RESEARCHING | PREPARING | APPLIED | INTERVIEW | OFFER | CLOSED | NOT_PURSUING
  appliedOn       DateTime? @db.Date
  interviewOn     DateTime? @db.Date
  notesCipher     String?
  prepNotesCipher String?
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz
}

// ───────────── Personal development & reviews ─────────────

/// Time you spent on something (study, speaking practice, reading…). Logged by you only.
model ActivityLog {
  id             String   @id @default(cuid())
  ownerId        String
  kind           String // STUDY | SPEAKING | READING | LEARNING | PROJECT | DISCIPLINE | CAREER_PREP | OTHER
  date           DateTime @db.Date
  minutes        Int
  title          String?
  note           String?
  goalId         String?
  courseId       String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([ownerId, date])
}

model Review {
  id               String   @id @default(cuid())
  ownerId          String
  kind             String // WEEK | MONTH
  periodStart      DateTime @db.Date
  reflectionCipher String?
  priorities       String[]
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  @@unique([ownerId, kind, periodStart])
}

// ═════════════════════════ Phase 4 — Assistant, reminders & notifications ═════════════════════════

/// Encrypted known value used to detect a missing or wrong DATA_ENCRYPTION_KEY. Reveals nothing about the key.
model EncryptionKeyCheck {
  id          String   @id
  checkCipher String
  createdAt   DateTime @default(now()) @db.Timestamptz
}

model NotificationPreference {
  ownerId           String   @id
  quietStart        String   @default("21:45")
  quietEnd          String   @default("05:45")
  categories        Json // { CATEGORY: boolean }
  modeRules         Json // { OVERTIME | ACTIVATION | RECOVERY: "ALL" | "IMPORTANT_ONLY" | "NONE" }
  briefingSections  String[]
  previewDetail     Boolean  @default(false) // lock-screen / push text stays generic unless you opt in
  briefingEnabled   Boolean  @default(true)
  checkInEnabled    Boolean  @default(true)
  reflectionEnabled Boolean  @default(true)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz
}

enum NotificationStatus {
  SCHEDULED
  DELIVERED
  DEFERRED // waiting for quiet hours to end
  SUPPRESSED // dropped by a work mode or disabled category — never delivered later
  SNOOZED
  DISMISSED
  FAILED
  EXPIRED // too late to be useful — no catch-up flood
}

enum NotificationPriority {
  IMPORTANT
  NORMAL
  LOW
}

model Notification {
  id           String               @id @default(cuid())
  ownerId      String
  kind         String // BRIEFING | CHECKIN | REFLECTION | REMINDER | REVIEW
  category     String
  priority     NotificationPriority
  title        String // generic, safe for a lock screen
  preview      String // safe preview; detailed only if you opt in
  detailCipher String? // private in-app detail, encrypted
  href         String
  dedupeKey    String
  scheduledFor DateTime             @db.Timestamptz
  expiresAt    DateTime             @db.Timestamptz
  status       NotificationStatus   @default(SCHEDULED)
  reason       String?
  deliveredAt  DateTime?            @db.Timestamptz
  readAt       DateTime?            @db.Timestamptz
  dismissedAt  DateTime?            @db.Timestamptz
  snoozedUntil DateTime?            @db.Timestamptz
  snoozeCount  Int                  @default(0)
  createdAt    DateTime             @default(now()) @db.Timestamptz
  updatedAt    DateTime             @default(now()) @updatedAt @db.Timestamptz
  deliveries   PushDelivery[]

  @@unique([ownerId, dedupeKey])
  @@index([status, scheduledFor])
  @@index([ownerId, createdAt])
}

model PushSubscription {
  id            String         @id @default(cuid())
  ownerId       String
  endpoint      String         @unique
  p256dh        String
  auth          String
  label         String?
  userAgent     String?
  failureCount  Int            @default(0)
  lastSuccessAt DateTime?      @db.Timestamptz
  revokedAt     DateTime?      @db.Timestamptz
  createdAt     DateTime       @default(now()) @db.Timestamptz
  deliveries    PushDelivery[]

  @@index([ownerId])
}

/// One row per (notification, device, delivery round). The unique key makes retries and concurrent workers safe.
model PushDelivery {
  id             String           @id @default(cuid())
  notificationId String
  notification   Notification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  round          Int              @default(0)
  status         String // SENT | FAILED | GONE
  attempts       Int              @default(0)
  lastError      String?
  createdAt      DateTime         @default(now()) @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @db.Timestamptz

  @@unique([notificationId, subscriptionId, round])
}

model SchedulerRun {
  id         String    @id @default(cuid())
  worker     String
  startedAt  DateTime  @default(now()) @db.Timestamptz
  finishedAt DateTime? @db.Timestamptz
  created    Int       @default(0)
  delivered  Int       @default(0)
  deferred   Int       @default(0)
  suppressed Int       @default(0)
  expired    Int       @default(0)
  failed     Int       @default(0)
  error      String?
}

model DailyReflection {
  id            String   @id @default(cuid())
  ownerId       String
  date          DateTime @db.Date
  bodyCipher    String?
  answersCipher String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz

  @@unique([ownerId, date])
}

/// "Not now" on an assistant suggestion. Hides that suggestion for the day; changes nothing else.
model AssistantDismissal {
  id        String   @id @default(cuid())
  ownerId   String
  date      DateTime @db.Date
  itemKey   String
  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([ownerId, date, itemKey])
}

// ───────────────────────── Gig income (Phase 5) ─────────────────────────
// Logged gig work is a record of effort and gross earnings. It is NEVER spendable money.
// Only a confirmed GigPayout creates an IncomeDeposit (kind GIG) in the ledger.

model GigPlatform {
  id         String       @id @default(cuid())
  ownerId    String
  name       String
  custom     Boolean      @default(false) // true for sources you added yourself
  sortOrder  Int          @default(0)
  archivedAt DateTime?    @db.Timestamptz
  createdAt  DateTime     @default(now()) @db.Timestamptz
  sessions   GigSession[]
  payouts    GigPayout[]
  mileage    GigMileage[]

  @@unique([ownerId, name])
}

model GigSettings {
  ownerId            String   @id
  monthlyTargetCents Int      @default(50000) // gross-income target, editable
  /// Planning estimate you choose (basis points of estimated profit). Null = not set. Never a tax calculation.
  taxReserveBps      Int?
  /// Your own vehicle cost per mile for planning, in thousandths of a dollar. Null = not set. Not a deduction rate.
  costPerMileMills   Int?
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz
}

enum GigPayStatus {
  PENDING // earned, payout not confirmed yet
  PAID // included in a confirmed payout
  DISPUTED // you flagged a problem with the platform
}

model GigSession {
  id                String       @id @default(cuid())
  ownerId           String
  platformId        String
  platform          GigPlatform  @relation(fields: [platformId], references: [id], onDelete: Restrict)
  workDate          DateTime     @db.Date
  startAt           DateTime?    @db.Timestamptz
  endAt             DateTime?    @db.Timestamptz
  minutes           Int // actual recorded time worked
  grossCents        Int // what the platform reported as earnings
  tipsCents         Int          @default(0)
  tipsInGross       Boolean      @default(true) // true = tips are already part of grossCents
  bonusCents        Int          @default(0)
  bonusInGross      Boolean      @default(true)
  parkingTollsCents Int          @default(0)
  otherExpenseCents Int          @default(0)
  notesCipher       String?
  status            GigPayStatus @default(PENDING)
  payoutId          String?
  payout            GigPayout?   @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  plannedEventId    String? // the planned calendar shift this session fulfils (optional)
  version           Int          @default(1)
  archivedAt        DateTime?    @db.Timestamptz // removed by you; kept as history
  createdAt         DateTime     @default(now()) @db.Timestamptz
  updatedAt         DateTime     @default(now()) @updatedAt @db.Timestamptz
  mileage           GigMileage?

  @@index([ownerId, workDate])
  @@index([payoutId])
}

model GigMileage {
  id                  String       @id @default(cuid())
  ownerId             String
  platformId          String?
  platform            GigPlatform? @relation(fields: [platformId], references: [id], onDelete: Restrict)
  tripDate            DateTime     @db.Date
  milesHundredths     Int
  purpose             String
  odometerStartTenths Int?
  odometerEndTenths   Int?
  sessionId           String?      @unique
  session             GigSession?  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  notes               String?
  archivedAt          DateTime?    @db.Timestamptz
  createdAt           DateTime     @default(now()) @db.Timestamptz
  updatedAt           DateTime     @default(now()) @updatedAt @db.Timestamptz

  @@index([ownerId, tripDate])
}

/// A payout you confirmed actually reached your account. Exactly one ledger deposit (kind GIG) per payout.
/// The amount lives only on the deposit, so it can never be counted twice.
model GigPayout {
  id             String        @id @default(cuid())
  ownerId        String
  platformId     String
  platform       GigPlatform   @relation(fields: [platformId], references: [id], onDelete: Restrict)
  depositId      String        @unique
  deposit        IncomeDeposit @relation(fields: [depositId], references: [id], onDelete: Restrict)
  externalRef    String? // optional payout ID from the platform, used for duplicate detection
  notes          String?
  idempotencyKey String        @unique
  requestHash    String
  voidedAt       DateTime?     @db.Timestamptz
  voidReason     String?
  createdAt      DateTime      @default(now()) @db.Timestamptz
  sessions       GigSession[]

  @@index([ownerId, createdAt])
}

// ───────────────────────── Automatic backups (pre-launch) ─────────────────────────

/// One backup / restore-test / download event. Never stores passphrases, keys or file contents.
model BackupRun {
  id              String    @id @default(cuid())
  kind            String // SCHEDULED | MANUAL | RESTORE_TEST | DOWNLOAD
  localDate       DateTime  @db.Date // New York date the run belongs to (one scheduled backup per day)
  status          String // RUNNING | SUCCEEDED | FAILED
  objectKey       String?
  bytes           Int?
  tables          Int?
  latestMigration String?
  counts          Json? // row counts at backup time, compared during restore tests
  error           String?
  startedAt       DateTime  @default(now()) @db.Timestamptz
  finishedAt      DateTime? @db.Timestamptz

  @@index([kind, localDate])
  @@index([startedAt])
}
