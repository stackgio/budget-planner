[
 {
  "id": "L1",
  "text": "This is VOO.",
  "start": 0.12,
  "end": 1.4
 },
 {
  "id": "L2",
  "text": "This is SCHD.",
  "start": 1.96,
  "end": 3.28
 },
 {
  "id": "L3",
  "text": "What's the difference?",
  "start": 3.78,
  "end": 4.44
 },
 {
  "id": "L4",
  "text": "Think of an ETF like a basket of stocks.",
  "start": 5.0,
  "end": 7.26
 },
 {
  "id": "L5",
  "text": "The difference is what goes in the basket.",
  "start": 7.68,
  "end": 9.64
 },
 {
  "id": "L6",
  "text": "VOO gives you a little piece of about five hundred big US companies across industries like tech,",
  "start": 10.14,
  "end": 15.52
 },
 {
  "id": "L7",
  "text": "banking, and healthcare.",
  "start": 15.82,
  "end": 16.82
 },
 {
  "id": "L8",
  "text": "SCHD focuses on companies with a history of paying dividends.",
  "start": 17.32,
  "end": 20.76
 },
 {
  "id": "L9",
  "text": "That's cash a company can pay you for owning its stock.",
  "start": 21.18,
  "end": 23.74
 },
 {
  "id": "L10",
  "text": "Now, this is QQQM.",
  "start": 24.28,
  "end": 26.5
 },
 {
  "id": "L11",
  "text": "This is VGT.",
  "start": 27.08,
  "end": 28.4
 },
 {
  "id": "L12",
  "text": "Both lean into tech.",
  "start": 28.9,
  "end": 29.94
 },
 {
  "id": "L13",
  "text": "So why is Costco in this one?",
  "start": 30.36,
  "end": 31.92
 },
 {
  "id": "L14",
  "text": "QQQM follows a list of big companies on the Nasdaq stock exchange.",
  "start": 32.38,
  "end": 36.36
 },
 {
  "id": "L15",
  "text": "That list includes tech companies and retailers like Costco.",
  "start": 36.86,
  "end": 39.64
 },
 {
  "id": "L16",
  "text": "VGT focuses on information technology.",
  "start": 40.14,
  "end": 42.64
 },
 {
  "id": "L17",
  "text": "Think software and computer chips.",
  "start": 43.06,
  "end": 44.68
 },
 {
  "id": "L18",
  "text": "Costco sells groceries, so it's out.",
  "start": 45.16,
  "end": 47.18
 },
 {
  "id": "L19",
  "text": "Two ETFs can sound similar.",
  "start": 47.72,
  "end": 49.26
 },
 {
  "id": "L20",
  "text": "The difference is what's inside.",
  "start": 49.64,
  "end": 51.14
 }
]